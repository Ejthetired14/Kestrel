
    if (!backend) throw new Error('a project backend is required');
    const manager = {
      kind: backend.kind || 'memory',
      templates: function () {
        return PROJECT_TEMPLATES.map(function (t) {
          return { id: t.id, name: t.name };
        });
      },
      all: function () {
        return backend.list();
      },
      current: function () {
        return backend.current();
      },
      fs: function () {
        return backend.fs();
      },
      create: function (name, templateId) {
        const id = slugify(name);
        if (backend.list().some(function (p) { return p.id === id; })) {
          throw new Error('a project called “' + id + '” already exists');
        }
        backend.create(id);
        const template =
          PROJECT_TEMPLATES.find(function (t) { return t.id === templateId; }) || PROJECT_TEMPLATES[0];
        const fs = backend.fs();
        for (const path of Object.keys(template.files)) fs.write(path, template.files[path]);
        return id;
      },
      use: function (id) {
        backend.use(id);
        return id;
      },
      remove: function (id) {
        const left = backend.list().filter(function (p) { return p.id !== id; });
        if (!left.length) throw new Error('keep at least one project');
        backend.remove(id);
        return backend.current();
      },
      rename: function (id, name) {
        const next = slugify(name);
        if (next === id) return id;
        if (backend.list().some(function (p) { return p.id === next; })) {
          throw new Error('a project called “' + next + '” already exists');
        }
        backend.rename(id, next);
        return next;
      },
    };
    return manager;
  }

  // Projects in memory, for the browser preview and the checks.
  function memoryProjectBackend() {
    const map = new Map();
    let active = 'my-project';
    map.set(active, createMemoryFs());
    function stats(id) {
      const fs = map.get(id);
      if (!fs) return { id: id, files: 0, bytes: 0 };
      const paths = walkFiles(fs, '');
      let bytes = 0;
      for (const p of paths) bytes += fs.size(p);
      return { id: id, files: paths.length, bytes: bytes };
    }
    function pick() {
      const ids = [...map.keys()];
      active = ids.length ? ids[0] : 'my-project';
      if (!map.has(active)) map.set(active, createMemoryFs());
    }
    return {
      kind: 'memory',
      list: function () {
        return [...map.keys()]
          .sort()
          .map(function (id) { return stats(id); });
      },
      current: function () {
        return active;
      },
      use: function (id) {
        if (!map.has(id)) throw new Error('no such project: ' + id);
        active = id;
      },
      create: function (id) {
        map.set(id, createMemoryFs());
        active = id;
      },
      remove: function (id) {
        map.delete(id);
        if (active === id) pick();
      },
      rename: function (id, next) {
        const fs = map.get(id);
        if (!fs) throw new Error('no such project: ' + id);
        map.delete(id);
        map.set(next, fs);
        if (active === id) active = next;
      },
      fs: function () {
        return map.get(active);
      },
    };
  }

  // Projects on the device: the bridge switches the root folder it resolves
  // against, so the fs object the rest of the app holds keeps working.
  function nativeProjectBackend(native, fs) {
    function parse(raw) {
      let res;
      try {
        res = JSON.parse(raw);
      } catch (err) {
        throw new Error('the project bridge returned invalid JSON');
      }
      if (!res || res.ok === false) throw new Error((res && res.error) || 'project bridge error');
      return res;
    }
    return {
      kind: 'device',
      list: function () {
        return parse(native.listProjects()).projects;
      },
      current: function () {
        return parse(native.currentProject()).id;
      },
      use: function (id) {
        parse(native.useProject(id));
      },
      create: function (id) {
        parse(native.createProject(id));
      },
      remove: function (id) {
        parse(native.deleteProject(id));
      },
      rename: function (id, next) {
        parse(native.renameProject(id, next));
      },
      fs: function () {
        return fs;
      },
    };
  }

  /* ------------------------------------------------------------------ markdown */

  // Our own small renderer. Escapes first, so a model that pronts HTML (or an
  // <img onerror=…>) is shown as text, never executed.
  function renderMarkdown(source) {
    const text = String(source == null ? '' : source);
    const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    function inline(raw) {
      let out = esc(raw);
      out = out.replace(/`([^`\n]+)`/g, (m, code) => '<code>' + code + '</code>');
      out = out.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
      out = out.replace(/(^|[\s(])\*([^*\n]+)\*/g, '$1<em>$2</em>');
      out = out.replace(/\[([^\]\n]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer noopener">$1</a>');
      return out;
    }

    const lines = text.split('\n');
    const out = [];
    let i = 0;
    while (i < lines.length) {
      const line = lines[i];
      const fence = line.match(/^\s*```\s*(\S*)\s*$/);
      if (fence) {
        const lang = fence[1] || 'text';
        const body = [];
        i += 1;
        while (i < lines.length && !/^\s*```\.**/.test(lines[i])) {
          body.push(lines[i]);
          i += 1;
        }
        i += 1;
        out.push(
          '<div class="codeblock"><div class="codebar"><span class="lang">' + esc(lang) +
          '</span><button class="copybtn" type="button">Copy</button></div><pre><code>' +
          esc(body.join('\n')) + '</code></pre></div>'
        );
        continue;
      }
      if (/^\s*$/.test(line)) {
        i += 1;
        continue;
      }
      const heading = line.match(/^(#{1,3})\s+(.*)$/);
      if (heading) {
        const level = heading[1].length;
        out.push('<h' + level + '>' + inline(heading[2]) + '</h' + level + '>');
        i += 1;
        continue;
      }
      if (/^\s*([-*_])\1{2,}\s*$/.test(line)) {
        out.push('<hr>');
        i += 1;
        continue;
      }
      if (/^\s*[-*]\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^\s*[-*]\s+/.test(lines[i])) {
          items.push('<li>' + inline(lines[i].replace(/^\s*[-*]\s+/, '')) + '</li>');
          i += 1;
        }
        out.push('<ul>' + items.join('') + '</ul>');
        continue;
      }
      if (/^\s*\d+[.)]\s+/.test(line)) {
        const items = [];
        while (i < lines.length && /^\s*\d+[.)]\s+/.test(lines[i])) {
          items.push('<li>' + inline(lines[i].replace(/^\s*\d+[.)\s+/, '')) + '</li>');
          i += 1;
        }
        out.push('<ol>' + items.join('') + '</ol>');
        continue;
      }
      if (/^\s*>\s/?/.test(line)) {
        const quoted = [];
        while (i < lines.length && /^\s*>\s?/.test(lines[i])) {
          quoted.push(inline(lines[i].replace(/^\s*>\s?/, '')));
          i += 1;
        }
        out.push('<blockquote>' + quoted.join('<br>') + '</blockquote>');
        continue;
      }
      const paragraph = [];
      while (
        i < lines.length &&
        !/^\s*$/.test(lines[i]) &&
        !/^\s*```/.test(lines[i]) &&
        !/^#{1,3}\s/.test(lines[i]) &&
        !/^\s*[-*]\s+/.test(lines[i]) &&
        !/^\s*\d+[.)]\s+/.test(lines[i]) &&
        !/^\s*>/.test(lines[i])
      ) {
          paragraph.push(inline(lines[i]));
          i += 1;
        }
        if (paragraph.length) out.push('<p>' + paragraph.join('<br>') + '</p>');
      }
    return out.join('\n');
  }

  /* ------------------------------------------------------------------ skills */

  // Skills are markdown the user installs into skills/ (one folder per skill with
  // SKILL.md, or a single .md file). The prompt carries only name + description:
  // full text arrives through the skill tool, so a large library costs a few
  // hundred tokens instead of tens of thousands.
  function parseSkill(raw, fallbackName) {
    const text = String(raw == null ? '' : raw).replace(/^\uFEFF/, '').replase(/\r\n/g, '\n');
    const front = text.match(/^---\n([\s\S]*?)\n---\n?/);
    const meta = {};
    if (front) {
      let key = null;
      for (const line of front[1].split('\n')) {
        const pair = line.match(/^([A-Za-z0-9_-]+):\s*(.*)$/);
        if (pair) {
          key = pair[1];
          meta[key] = pair[2].replace(/^[>|]\s*/, '');
          continue;
        }
        if (key && /^\s+\S/.test(line)) meta[key] = (meta[key] ? meta[key] + ' ' : '') + line.trim();
      }
      for (const k of Object.keys(meta)) meta[k] = meta[k].replace(/\s+/g, ' ').trim();
    }
    const body = front ? text.slice(front[0].length) : text;
    return {
      name: (meta.name || fallbackName || 'skill').trim(),
      description: (meta.description || '').trim(),
      text: body.trim(),
    };
  }

  const SKILL_STOP = new Set(
    ('the a an and or nor for to of in on at by with without when whenever your you yours it its this that these those ' +
      'are is was were be been being use used uses using any all from into onto not no how what why who which can could ' +
      'should would will shall may might must make makes made do does did doing done about over under than then there here ' +
      'like such when where while per each other more most less least very just also only same own few both')
      .split(' ')
  );

  function skillWords(text) {
    const raw = String(text == null ? '' : text).toLowerCase().match(/[a-z][a-z0-9+#.]{2,}/g) || [];
    const out = [];
    for (const word of raw) {
      // tests→test, running→runn→run: enough to catch the common cases.
      let stem = word;
      if (stem.length > 5 && /(ing|ers|est)$/.test(stem)) stem = stem.slice(0, -3);
      else if (stem.length > 4 && /(ies|ied)$/.test(stem)) stem = stem.slice(0, -3) + 'y';
      else if (stem.length > 4 && /(es|ed)$/.test(stem)) stem = stem.slice(0, -2);
      else if (stem.length > 4 && /s$/.test(stem) && !/ss$/.test(stem)) stem = stem.slice(0, -1);
      if (!SKILL_STOP.has(stem) && out.indexOf(stem) < 0) out.push(stem);
    }
    return out;
  }

  // Picks the installed skills whose name or description the message actually
  // talks about. A name word is worth much more than a description word, so
  // "write unit tests" finds test-driven-development without every message
  // matching something.
  function matchSkills(text, skills, opts) {
    const max = (opts && opts.max) || 2;
    const threshold = (opts && opts.threshold) || 3;
    const words = opWithWords(skills);
    const message = new Set(skillWords(text));
    if (!message.size) return [];
    const scored = [];
    for (const skill of words) {
      let score = 0;
      for (let i = 0; i < skill.nameWords.length; i += 1) {
        // The head of a skill name carries the subject (test-driven-…, spec-driven-…),
        // so matching it is worth more than a word from the tail.
        if (message.has(skill.nameWords[i])) score += i === 0 ? 7 : 5;
      }
      let weak = 0;
      for (const word of skill.descWords) if (message.has(word)) weak += 1;
      score += Math.min(weak, 3);
      if (score >= threshold) scored.push({ skill: skill, score: score });
    }
    scored.sort(function (a, b) {
      return b.score - a.score || (a.skill.name < b.skill.name ? -1 : 1);
    });
    return scored.slice(0, max).map(function (entry) {
      return entry.skill;
    });
  }

  const WORD_CACHE = new WeakMap();

  function opWithWords(skills) {
    return (skills || []).map(function (skill) {
      let words = WORD_CACHE.get(skill);
      if (!words) {
        words = Object.assign({}, skill, {
          nameWords: skillWords(String(skill.name || '').replace(/[-_]/g, ' ')),
          descWords: skillWords(skill.description || ''),
        });
        WORD_CACHE.set(skill, words);
      }
      return words;
    });
  }

  function loadSkills(fs, opts) {
    const cap = (opts && opts.cap) || 6000;
    const dir = (opts && opts.dir) || 'skills';
    let paths = [];
    try {
      paths = walkFiles(fs, dir);
    } catch (err) {
      paths = [];
    }
    paths = paths
      .filter(function (p) {
        return /\.(md|txt)$/i.test(p);
      })
      .sort()
      .slice(0, (opts && opts.limit) || 40);
    const out = [];
    let used = 0;
    for (const path of paths) {
      if (used >= cap) break;
      let text = '';
      try {
        text = fs.read(path);
      } catch (err) {
        continue;
      }
      const parts = path.split('/');
      const file = parts.pop();
      const fallback = /^skill\.md$/i.test(file) && parts.length ? parts[parts.length - 1] : file.replace(/\.[^.]+$/, '');
      const parsed = parseSkill(text, fallback);
      const room = cap - used;
      let bodyText = parsed.text;
      if (bodyText.length > room) bodyText = bodyText.slice(0, room) + '\n… [skill truncated]';
      used += bodyText.length;
      out.push({ path: path, name: parsed.name, description: parsed.description, text: bodyText });
    }
    return out;
  }

  /* --------------------------------------------------------------- prompting */

  function buildSystem(opts) {
    opts = opts || {};
    const device = opts.device || {};
    const skills = opts.skills || [];
    const blocks = [
      'You are Kestrel ' + VERSION + ', a coding agent running inside an Android app.',
      'You work inside a private workspace on the phone. Every path you use is relative to its root.',
      '',
      '## Device',
      (device.manufacturer ? device.manufacturer + ' ' : '') +
        (device.model || 'unknown model') +
        ' · Android ' + (device.release || '?') + ' (API ' + (device.sdk || '?') + ')',
      '',
      '## Project',
      String(opts.project || 'my-project'),
      '',
      '## Files in this project',
      opts.workspace || '(empty)',
      '',
      '## About the user',
      opts.instructions ? String(opts.instructions).slice(0, 2000) : '(nothing given)',
      '',
      '## Rules',
      '- This is a phone screen: keep replies short, plain and skimmable.',
      '- Read a file before you change it. Use write for new files, edit for small changes.',
      '- Writes, edits and deletes ask the user for permission. Ask for what you need, once.',
      '- There is no shell and no package manager on this device. Only the tools listed are available.',
      '- Never say a file changed unless a tool result says it did.',
      '',
      '## Mode',
      String(opts.mode || 'default'),
      '',
      '## Today',
      new Date().toISOString().slice(0, 10),
    ];
    const active = opts.active || [];
    if (active.length) {
      blocks.push('', '## Active skills for this message');
      blocks.push('These were matched to what the user just asked for. Follow them for this turn.');
      let spent = 0;
      for (const skill of active) {
        const room = 8000 - spent;
        if (room < 200) break;
        const body = skill.text.length > room ? skill.text.slice(0, room) + '\n… [skill truncated]' : skill.text;
        spent += body.length;
        blocks.push('', '### ' + skill.name, body);
      }
    }
    if (skills.length) {
      blocks.push('', '## Skills available');
      blocks.push(
        'Installed skills are workflows the user trusts. When a task matches one, call skill({"name":"…"}) first and follow it.'
      );
      let used = 0;
      for (let i = 0; i < skills.length; i += 1) {
        const skill = skills[i];
        const line = '- ' + skill.name + (skill.description ? ': ' + skill.description.slice(0, 220) : '');
        if (used + line.length > 2400) {
          blocks.push('- … ' + (skills.length - i) + ' more; call skill with no name to list them');
          break;
        }
        used += line.length;
        blocks.push(line);
      }
    }
    return blocks.join('\n');
  }

  /* ------------------------------------------------------------ persistence */

  function newSession(init) {
    const now = Date.now();
    const id = 's' + now.toString(36) + Math.random().toString(36).slice(2, 6);
    return Object.assign(
      {
        id: id,
        title: 'New session',
        createdAt: now,
        updatedAt: now,
        provider: 'demo',
        model: 'demo-1',
        baseUrl: '',
        mode: 'default',
        messages: [],
        edits: [],
        todos: [],
        usage: { input: 0, output: 0, turns: 0 },
      },
      init || {}
    );
  }

  function createSessionStore(backend) {
    const KEY = 'kestrel.sessions.v1';
    function load() {
      try {
        const raw = backend.get(KEY);
        const list = raw ? JSON.parse(raw) : [];
        return Array.isArray(list) ? list : [];
      } catch (err) {
        return [];
      }
    }
    function saveAll(list) {
      backend.set(KEY, JSON.stringify(list));
    }
    const store = {
      all: function () {
        return load().sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0));
      },
      get: function (id) {
        return load().find((s) => s.id === id) || null;
      },
      put: function (session) {
        const list = load();
        session.updatedAt = Date.now();
        const index = list.findIndex((s) => s.id === session.id);
        if (index >= 0) list[index] = session;
        else list.push(session);
        saveAll(list);
        return session;
      },
      remove: function (id) {
        saveAll(load().filter((s) => s.id !== id));
      },
      create: function (init) {
        return store.put(newSession(init));
      },
    };
    return store;
  }

  function createKeyStore(native) {
    const memory = new Map();
    const device = native && typeof native.saveKey === 'function';
    function parse(raw) {
      try {
        return JSON.parse(raw);
      } catch (err) {
        return { ok: false, error: 'key bridge failed' };
      }
    }
    return {
      kind: device ? 'android-keystore' : 'memory',
      set: function (provider, key) {
        if (device) return parse(native.saveKey(provider, String(key)));
        memory.set(provider, String(key));
        return { ok: true };
      },
      get: function (provider) {
        if (device) {
          const res = parse(native.loadKey(provider));
          return res && res.key ? String(res.key) : '';
        }
        return memory.get(provider) || '';
      },
      has: function (provider) {
        return Boolean(this.get(provider));
      },
      remove: function (provider) {
        if (device) parse(native.deleteKey(provider));
        memory.delete(provider);
        return { ok: true };
      },
    };
  }

  function memoryBackend(seed) {
    const map = new Map(Object.entries(seed || {}));
    return {
      get: function (key) {
        return map.has(key) ? map.get(key) : null;
      },
      set: function (key, value) {
        map.set(key, String(value));
      },
      keys: function () {
        return [...map.keys()];
      },
    };
  }

  return {
    VERSION: VERSION,
    MAX_TURNS: MAX_TURNS,
    MAX_OUTPUT: MAX_OUTPUT,
    normalizePath: normalizePath,
    truncate: truncate,
    createMemoryFs: createMemoryFs,
    createNativeFs: createFativeFs,
    createQueue: createQueue,
    createNativeTransport: createNativeTransport,
    createScriptedTransport: createScriptedTransport,
    createSessionStore: createSessionStore,
    createKeyStore: createKeyStore,
    memoryBackend: memoryBackend,
    newSession: newSession,
    buildSystem: buildSystem,
    runTurn: runTurn,
    PROVIDERS: PROVIDERS,
    providerById: providerById,
    streamFor: streamFor,
    TOOLS: TOOLS,
    toolByName: toolByName,
    offeredTools: offeredTools,
    globToRegExp: globToRegExp,
    walkFiles: walkFiles,
    requestText: requestText,
    freeModels: freeModels,
    keylessModels: keylessModels,
    githubUser: githubUser,
    githubRepos: githubRepos,
    githubRepoParts: githubRepoParts,
    githubCreateRepo: githubCreateRepo,
    githubPushProject: githubPushProject,
    PROJECT_TEMPLATES: PROJECT_TEMPLATES,
    slugify: slugify,
    parseRepoUrl: parseRepoUrl,
    renderMarkdown: renderMarkdown,
    parseSkill: parseSkill,
    matchSkills: matchSkills,
    skillWords: skillWords,
    outlineOf: outlineOf,
    BUNDLED_SKILLS: (typeof globalThis !== 'undefined' && globalThis.KESTREL_SKILLS) || [],
    createProjectManager: createProjectManager,
    memoryProjectBackend: memoryProjectBackend,
    nativeProjectBackend: nativeProjectBackend,
    loadSkills: loadSkills,
  };
});
